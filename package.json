{
  "name": "@atatter/atlassian-mcp",
  "version": "0.0.0",
  "description": "Local MCP server for Jira Cloud with per-project permissions and keychain-stored credentials",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atatter/atlassian-mcp.git"
  },
  "bin": {
    "atlassian-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "scan:secrets": "node scripts/scan-secrets.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm scan:secrets",
    "check:pack": "pnpm build && node scripts/check-pack.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
